    "env/features/residual.py": "3385a9d8024e065c6cb3d20d672142a32dcfbfb8df64941c2bfc4032f502f98a",
    "backtest/residual_reports.py": "67965d47ca39da8f0eef0e8472eb197b09eced06186a1114869f416f7bdc9410"
  },
  "synthetic_gate_passed": true
}