{
  "capacity_mode": "full-target",
  "seed": 42,
  "optimizer_seed": 83,
  "steps_per_ppo_per_eligible_fold": 50000,
  "settings": {
    "gross": 0.25,
    "cost_rate": 0.0002,
    "funding": 0.02,
    "borrow": 0.005,
    "cash": 0.0,
    "adv_fraction": 0.01,
    "lambda_risk": 1.0,
    "lambda_turn": 5e-05,
    "strict_volume": true,
    "unwind_sessions": 20
  },
  "available_timesteps": [
    256,
    50000,
    250000,
    1000000
  ],
  "checkpoint": "highest validation net return, earliest tie",
  "config": {
    "data": {
      "start_date": "2014-01-01",
      "end_date": "2024-01-01",
      "assets_path": "config/pairs.yaml",
      "price_type": "Adj Close",
      "source": "yfinance",
      "cache_path": "outputs/daily_validation/cache/yfinance_daily_500plus_2014_2024.csv",
      "min_history": 500,
      "max_ffill_gap": 5,
      "resample_frequency": "1D",
      "quality_report_path": "outputs\\runs\\audit_ppo\\data_quality.csv",
      "wavelet": {
        "enabled": true,
        "name": "db4",
        "level": 3,
        "window": 64
      }
    },
    "pairs": {
      "correlation_threshold": 0.8,
      "allow_positive": false,
      "allow_negative": true,
      "use_cointegration": true,
      "cointegration_p_value": 0.05,
      "min_observations": 300,
      "traditional_min_annual_vol": 0.15,
      "traditional_max_annual_vol": null,
      "inverse_min_annual_vol": null,
      "inverse_max_annual_vol": null,
      "max_traditional_pairs": 30,
      "max_inverse_pairs": null,
      "multiple_testing": "holm"
    },
    "env": {
      "window_size": 30,
      "initial_capital": 100000,
      "max_position": 0.25,
      "max_total_exposure": 2.0,
      "transaction_cost": 0.0001,
      "slippage_cost": 0.0001,
      "cost_model": "turnover",
      "borrow_fee_annual": 0.005,
      "financing_rate_annual": 0.02,
      "cash_rate_annual": 0.0,
      "signal_lag_bars": 1,
      "liquidity": {
        "enabled": true,
        "adv_window": 20,
        "max_trade_pct_adv": 0.01
      }
    },
    "features": {
      "min_periods": 60,
      "base_window": 30
    },
    "rl": {
      "algorithm": "PPO",
      "hyperparameters": {
        "policy": "MlpPolicy",
        "learning_rate": 0.00015,
        "n_steps": 64,
        "batch_size": 32,
        "timesteps": 256,
        "n_epochs": 2,
        "gamma": 0.99,
        "gae_lambda": 0.95,
        "clip_range": 0.2,
        "ent_coef": 0.0,
        "vf_coef": 0.5,
        "max_grad_norm": 0.5
      }
    },
    "walkforward": {
      "enabled": true,
      "train_years": 3,
      "validation_months": 6,
      "test_months": 6,
      "min_train_size": 500,
      "min_test_size": 120,
      "retrain_pairs_each_window": true,
      "retrain_env_each_window": true,
      "retrain_kelly_each_window": false,
      "mode": "rolling",
      "feature_context_days": 252
    },
    "validation": {
      "run_baselines": true
    },
    "elasticnet": {
      "alpha": 0.01,
      "l1_ratio": 0.5,
      "max_iter": 20000,
      "importance_threshold": 0.0
    },
    "kelly": {
      "fraction": 0.25,
      "leverage_cap": 3.0,
      "volatility_floor": "1e-6"
    },
    "reward": {
      "reward_clip": 5.0,
      "pos_penalty": 0.01
    },
    "training": {
      "log_interval": 500,
      "save_dir": "outputs\\runs\\audit_ppo\\models",
      "progress_bar": false
    },
    "evaluation": {
      "rolling_sharpe_window": 90,
      "rolling_sortino_window": 90,
      "rolling_vol_window": 90,
      "annualization_factor": 252,
      "save_equity_curve": true,
      "compare_to_spy": true
    },
    "plotting": {
      "equity_curve": false,
      "compare_spy": false,
      "final_allocation": false,
      "return_distribution": false,
      "monthly_heatmap": false,
      "drawdown_curve": false,
      "ulcer_index_curve": false,
      "cdar_plot": false,
      "rolling_sharpe": false,
      "rolling_sortino": false,
      "rolling_vol": false,
      "trade_pnl_distribution": false,
      "gain_to_pain": false
    },
    "logging": {
      "log_to_file": true,
      "log_path": "logs/",
      "verbosity": "INFO"
    },
    "system": {
      "seed": 42,
      "device": "cpu",
      "num_workers": 1
    },
    "output": {
      "run_dir": "outputs\\runs\\audit_ppo"
    }
  },
  "packages": {
    "numpy": "2.4.2",
    "pandas": "3.0.1",
    "torch": "2.12.1",
    "stable-baselines3": "2.9.0",
    "xgboost": "3.4.1",
    "scikit-learn": "1.9.0",
    "statsmodels": "0.14.6"
  },
  "source_sha256": {
    "residual_control_study.py": "0929dc1960d0d210ddf5aa85a2cdd0f3ffca948efc5b0e3c36b5b066895e258e",
